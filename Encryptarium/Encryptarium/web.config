<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<handlers>
				<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>
			<aspNetCore processPath="dotnet" arguments=".\Encryptarium.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
				<environmentVariables>
					<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
					<environmentVariable name="SECRET" value="MyVeryTopSecretKey256bitMinimalSizeForCorrectlyWork" />
					<environmentVariable name="AES_IV" value="InitVector" />
					<environmentVariable name="AES_Key" value="PrivateKey" />
					<environmentVariable name="AdminPassword" value="Admin-12345" />
					<environmentVariable name="ConnectionStrings__MainDb"
					 value="Data Source=C:/inetpub/wwwroot/Encryptarium.Main/mydatabase.db;Mode=ReadWrite" />
				</environmentVariables>
			</aspNetCore>
		</system.webServer>
	</location>
</configuration>
